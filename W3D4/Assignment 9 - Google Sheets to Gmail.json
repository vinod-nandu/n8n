    {
      "parameters": {
        "jsCode": "// Build a clean, human-readable email subject and body from the sheet rows.\nconst data = items[0].json;\nconst rows = data.rows;\n\nconst today = new Date().toLocaleDateString('en-US', {\n  year: 'numeric', month: 'long', day: 'numeric'\n});\n\nconst subject = `Sheet Report - ${rows.length} record(s) - ${today}`;\n\n// Build a readable list from each row's key/value pairs.\nconst rowBlocks = rows.map((row, index) => {\n  const lines = Object.entries(row)\n    .map(([key, value]) => `  ${key}: ${value}`)\n    .join('\\n');\n  return `Record ${index + 1}\\n${lines}`;\n}).join('\\n\\n');\n\nconst body =\n`Hello,\n\nHere is the latest data pulled from the Google Sheet (${rows.length} record(s) as of ${today}):\n\n${rowBlocks}\n\nThis email was generated automatically by an n8n workflow.\n\nBest,\nAutomation Bot`;\n\nreturn [\n  {\n    json: {\n      subject: subject,\n      body: body\n    }\n  }\n];"
      },
