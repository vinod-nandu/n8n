    {
      "parameters": {
        "jsCode": "// Aggregate all incoming rows into one item so a single email can be sent.\n// Also flags whether the sheet actually had data.\nconst rows = items.map(item => item.json);\n\nreturn [\n  {\n    json: {\n      rows: rows,\n      rowCount: rows.length,\n      hasData: rows.length > 0\n    }\n  }\n];"
      },
      "id": "c730ce50-7cbd-4f5b-bf04-35f6952ae364",
      "name": "Aggregate Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        48
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
